# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# .env is gitignored. If you ever commit a real secret, rotate it - removing it
# from a later commit does not remove it from git history.

# Admin dashboard password.
OTREE_ADMIN_PASSWORD=

# Session-signing key. Generate a fresh random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTREE_SECRET_KEY=

# Set to DEV for local work, PRODUCTION for a deployment.
OTREE_PRODUCTION=DEV

# Database. Omit for local SQLite; on a host this is usually provided for you.
# DATABASE_URL=postgres://user:password@host:5432/dbname
